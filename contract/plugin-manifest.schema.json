{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-plugin-app.example/schema/plugin-manifest-v1.json",
  "title": "Personal Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "description", "entry", "routes", "menu", "capabilities", "backend", "data"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$", "maxLength": 128 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["shell"],
      "properties": { "shell": { "type": "string", "pattern": "^\\./[a-zA-Z0-9_./-]+\\.js$" }, "standalone": { "type": "string", "format": "uri" } }
    },
    "routes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["path", "title"], "properties": { "path": { "type": "string" }, "title": { "type": "string", "minLength": 1 } } }
    },
    "menu": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["label", "route"], "properties": { "label": { "type": "string", "minLength": 1 }, "route": { "type": "string" } } }
    },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["profile.basic", "navigation.openExternal"] } },
    "backend": {
      "type": "object", "additionalProperties": false, "required": ["audience", "origin"],
      "properties": { "audience": { "type": "string", "minLength": 1 }, "origin": { "type": "string", "format": "uri" } }
    },
    "data": {
      "type": "object", "additionalProperties": false, "required": ["owner", "exportSchemaVersion"],
      "properties": { "owner": { "const": "plugin" }, "exportSchemaVersion": { "type": "integer", "minimum": 1 } }
    }
  }
}
