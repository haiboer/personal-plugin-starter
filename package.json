{
  "name": "@personal/plugin-starter-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.standalone.config.ts --host 127.0.0.1",
    "build": "npm run build:plugin",
    "build:plugin": "vite build",
    "build:preview": "npm run build:standalone",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "check:manifest": "node contract/bin/check-plugin.mjs plugin-manifest.json",
    "check:consistency": "npm run build:plugin && vitest run tests/consistency.test.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run build:plugin && vitest run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@personal/plugin-sdk": "file:./sdk"
  },
  "peerDependencies": {
    "@ionic/vue": "^8.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@ionic/vue": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0",
    "vue-tsc": "^3.3.13"
  }
}
